Potential Adopters = INTEG ( -Adoption Rate, Total Population )
	~	Person
	~		|

Adopters = INTEG ( Adoption Rate, 0 )
	~	Person
	~		|

Adoption Rate = Adoption from Advertising + Adoption from Word of Mouth
	~	Person/Year
	~		|

Total Population = 1000
	~	Person
	~		|

Advertising Effectiveness = 0.03
	~	1/Year
	~	Bass innovation coefficient p	|

Word of Mouth Strength = 0.38
	~	1/Year
	~	Bass imitation coefficient q	|

Adoption from Advertising = Advertising Effectiveness * Potential Adopters
	~	Person/Year
	~		|

Adoption from Word of Mouth = Word of Mouth Strength * Adopters * Potential Adopters / Total Population
	~	Person/Year
	~		|

INITIAL TIME = 0
	~	Year
	~		|

FINAL TIME = 30
	~	Year
	~		|

TIME STEP = 0.125
	~	Year
	~		|

SAVEPER = TIME STEP
	~	Year
	~		|

