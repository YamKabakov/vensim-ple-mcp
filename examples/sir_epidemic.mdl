{UTF-8}

Susceptible = INTEG ( -Infection Rate - Vaccination Rate, Total Population - Initial Infected )
	~	Person
	~		|

Infected = INTEG ( Infection Rate - Recovery Rate, Initial Infected )
	~	Person
	~		|

Recovered = INTEG ( Recovery Rate, 0 )
	~	Person
	~		|

Infection Rate = Contact Rate * Transmission Probability * Susceptible * Infected / Total Population
	~	Person/Day
	~		|

Recovery Rate = Infected / Illness Duration
	~	Person/Day
	~		|

Total Population = 10000
	~	Person
	~		|

Initial Infected = 10
	~	Person
	~		|

Contact Rate = 6
	~	1/Day
	~	Contacts per person per day	|

Transmission Probability = 0.05
	~	Dmnl
	~	Probability a contact transmits	|

Illness Duration = 5
	~	Day
	~		|

Vaccinated = INTEG ( Vaccination Rate, 0 )
	~	Person
	~		|

Vaccination Fraction = 0.01
	~	1/Day
	~	Share of susceptibles vaccinated per day
	|

Vaccination Rate = Susceptible * Vaccination Fraction
	~	Person/Day
	~		|

INITIAL TIME = 0
	~	Day
	~		|

FINAL TIME = 120
	~	Day
	~		|

TIME STEP = 0.25
	~	Day
	~		|

SAVEPER = TIME STEP
	~	Day
	~		|

