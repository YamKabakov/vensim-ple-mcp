{UTF-8}

Active Users = INTEG ( Acquisition - Attrition, 100 )
	~	User
	~	Current active user base	|

Acquisition = Base Acquisition * Remaining Market / Market Potential + Word of Mouth
	~	User/Month
	~		|

Attrition = Active Users * Churn Fraction
	~	User/Month
	~		|

Market Potential = 10000
	~	User
	~		|

Remaining Market = MAX ( Market Potential - Active Users, 0 )
	~	User
	~		|

Contact Effectiveness = 0.035
	~	1/Month
	~		|

Word of Mouth = Contact Effectiveness * Active Users * Remaining Market / Market Potential
	~	User/Month
	~		|

Campaign Budget = 70
	~	Currency/Month
	~		|

Campaign Efficiency = 1.8
	~	User/Currency
	~		|

Base Acquisition = Campaign Budget * Campaign Efficiency
	~	User/Month
	~		|

Churn Fraction = 0.025
	~	1/Month
	~		|

INITIAL TIME = 0
	~	Month
	~		|

FINAL TIME = 60
	~	Month
	~		|

TIME STEP = 0.25
	~	Month
	~		|

SAVEPER = TIME STEP
	~	Month
	~		|

